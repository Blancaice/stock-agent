# LLM 配置
# OpenAI 兼容 API（支持 OpenAI / Azure / DeepSeek / 本地模型）
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Redis 配置（可选，用于缓存，推荐开启）
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL=3600

# 数据源配置（可选）
TUSHARE_TOKEN=your-tushare-token

# Fuyao / HiThink 同花顺金融数据 API（用于 REST 调用；Codex MCP 开发侧也可复用）
# 新文档推荐 HITHINK_FINANCE_API_KEY；项目仍兼容旧 FUYAO_API_KEY。
HITHINK_FINANCE_API_KEY=your-hithink-finance-api-key
FUYAO_API_KEY=your-fuyao-api-key
# FUYAO_TOKEN=your-legacy-fuyao-token
